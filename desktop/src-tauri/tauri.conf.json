{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Workproba",
  "version": "0.1.3",
  "identifier": "fr.improba.workproba",
  "build": {
    "frontendDist": "../../front/dist/spa",
    "devUrl": "http://localhost:5053",
    "beforeDevCommand": "cd ../front && DESKTOP_MODE=true yarn dev",
    "beforeBuildCommand": "cd ../front && DESKTOP_MODE=true yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Workproba",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* asset: https: data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/workproba-ai"],
    "resources": ["resources/ms-playwright"],
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Improba",
    "copyright": "Copyright © Improba",
    "category": "Productivity",
    "shortDescription": "Assistant de travail local-first",
    "longDescription": "Workproba est un assistant de travail bilingue pour documents locaux et collaboration projet.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": ["fr-FR", "en-US"]
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libnss3",
          "libgbm1",
          "libasound2 | libasound2t64",
          "libatk-bridge2.0-0",
          "libcups2",
          "libdrm2",
          "libxkbcommon0",
          "libxcomposite1",
          "libxdamage1",
          "libxrandr2"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
